@@ -0,0 +1,56 @@
+import { renderToStaticMarkup } from 'react-dom/server'
+import type { ScriptProps } from 'next/script'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+
+const { scriptMock } = vi.hoisted(() => ({
+  scriptMock: vi.fn((_props: ScriptProps) => null),
+}))
+
+vi.mock('next/script', () => ({ default: scriptMock }))
+
+import { Umami } from '../../src/analytics/Umami'
+
+const renderUmami = (props: Parameters<typeof Umami>[0]) => {
+  renderToStaticMarkup(<Umami {...props} />)
+  return scriptMock.mock.calls[0][0]
+}
+
+describe('Umami', () => {
+  afterEach(() => {
+    scriptMock.mockClear()
+  })
+
+  it('forwards an explicit Next.js script strategy', () => {
+    const scriptProps = renderUmami({
+      umamiWebsiteId: 'website-id',
+      strategy: 'lazyOnload',
+    })
+
+    expect(scriptProps).toMatchObject({
+      src: 'https://analytics.umami.is/script.js',
+      strategy: 'lazyOnload',
+      'data-website-id': 'website-id',
+    })
+  })
+
+  it('preserves Next.js default scheduling when strategy is omitted', () => {
+    const scriptProps = renderUmami({ umamiWebsiteId: 'website-id' })
+
+    expect(scriptProps.strategy).toBeUndefined()
+    expect(scriptProps['data-strategy']).toBeUndefined()
+  })
+
+  it('keeps mapping Umami and custom data attributes', () => {
+    const scriptProps = renderUmami({
+      umamiWebsiteId: 'website-id',
+      umamiAutoTrack: false,
+      dataPerformance: 'true',
+    })
+
+    expect(scriptProps).toMatchObject({
+      'data-website-id': 'website-id',
+      'data-auto-track': 'false',
+      'data-performance': 'true',
+    })
+  })
+})
