# Regenerable output. READMEs, protocols, scripts, and compact results stay tracked.
**/node_modules/
**/.next/
**/.next-*/
**/target/

# Large screenshot sets; each experiment's visual-parity JSON keeps the comparison result.
critical-css-delivery/results/**/*.png
tailwind-source-boundary/results/screenshots/*.png
**/results/screenshots/*-dom-diff.json

# Per-compiler inventories; automatic-compile.json stays as the evidence for the dependency count.
tailwind-source-boundary/results/compiler-[0-9]-*-compile.json
tailwind-source-boundary/results/assets/compiler-*

# The root *.log rule would drop logs this experiment's README says were kept.
!route-css-graph/results/logs/*.log
