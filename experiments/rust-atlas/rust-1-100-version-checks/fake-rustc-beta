#!/usr/bin/env bash
# Prints the version text of the 1.100.0-beta.7 compiler and runs the real 1.99.1 compiler for everything else.
for argument in "$@"; do
  case "$argument" in
    -V | --version | -vV | -Vv)
      rustup run 1.99.1 rustc "$@" | sed -e "s/1\.99\.1/1.100.0-beta.7/g" -e "s/58cf8f9c3 2026-10-13/fd8e211ae 2026-10-17/"
      exit "${PIPESTATUS[0]}"
      ;;
  esac
done
exec rustup run 1.99.1 rustc "$@"
