#!/usr/bin/env bash
# Prints the version text Rust 1.100.0 will print and runs the real 1.99.1 compiler for everything else.
for argument in "$@"; do
  case "$argument" in
    -V | --version | -vV | -Vv)
      rustup run 1.99.1 rustc "$@" | sed 's/1\.99\.1/1.100.0/g'
      exit "${PIPESTATUS[0]}"
      ;;
  esac
done
exec rustup run 1.99.1 rustc "$@"
