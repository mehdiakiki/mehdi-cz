{
  "name": "tailwind-nextjs-starter-blog",
  "version": "2.2.0",
  "private": true,
  "scripts": {
    "start": "yarn dev",
    "dev": "cross-env INIT_CWD=$PWD concurrently --kill-others --names content,next 'contentlayer2 dev' 'next dev --turbopack'",
    "build": "yarn prebuild && cross-env NODE_ENV=production INIT_CWD=$PWD contentlayer2 build && yarn test:publication && cross-env INIT_CWD=$PWD next build --webpack && yarn performance:flight:build && cross-env NODE_OPTIONS='--experimental-json-modules' node ./scripts/postbuild.mjs",
    "prebuild": "node scripts/generate-article-style-assets.mjs && node scripts/audit-blog-heading-order.mjs && node scripts/audit-authority-campaign.mjs",
    "serve": "next start",
    "analyze": "cross-env NODE_ENV=production contentlayer2 build && cross-env ANALYZE=true next build --webpack",
    "performance:audit": "node scripts/performance-audit.js",
    "performance:article-styles": "node scripts/generate-article-style-assets.mjs",
    "performance:flight": "node scripts/analyze-flight-chunk-lists.mjs",
    "performance:flight:build": "yarn performance:flight --max-repeated-share=0.02 --max-repeated-bytes=10000 --min-reference-rows=1 .next/server/app/index.html .next/server/app/blog.html .next/server/app/rust.html .next/server/app/rust-failure-atlas.html .next/server/app/blog/BufReader-rust.html",
    "publications:status": "node scripts/check-publication-due.mjs --status",
    "content:campaign": "node scripts/audit-authority-campaign.mjs",
    "content:calendar": "node scripts/show-authority-calendar.mjs",
    "content:opportunities": "node scripts/list-authority-opportunities.mjs",
    "content:scaffold": "node scripts/scaffold-authority-article.mjs",
    "content:review-hash": "node scripts/hash-article-review.mjs",
    "content:verify-rust-claims": "cargo test --locked --offline --manifest-path experiments/rust-atlas/aho-corasick-claims/Cargo.toml",
    "content:verify-rust-failures": "node scripts/verify-rust-failure-evidence.mjs",
    "content:audit-rust-failures": "node scripts/audit-rust-failure-atlas.mjs",
    "content:audit-headings": "node scripts/audit-blog-heading-order.mjs",
    "content:measure-rust-atlas": "node scripts/analyze-rust-atlas-growth.mjs",
    "test:publication": "node --test tests/publication.test.mjs tests/publication-scheduler.test.mjs tests/content-review.test.mjs tests/content-integrity.test.mjs tests/authority-campaign.test.mjs tests/authority-schedule.test.mjs tests/authority-scaffold.test.mjs tests/deployment-foundation.test.mjs tests/prerender-budget.test.mjs tests/rust-failure-atlas.test.mjs tests/rust-failure-audit.test.mjs tests/aho-corasick-editorial-cluster.test.mjs tests/editorial-clusters.test.mjs tests/rust-atlas-growth-experiments.test.mjs tests/article-style-assets.test.mjs tests/toolchain-compatibility.test.mjs tests/writing-tiers.test.mjs",
    "lint": "eslint app components lib layouts scripts --fix",
    "prepare": "husky",
    "optimize-images": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "@formspree/react": "^3.0.0",
    "@headlessui/react": "2.2.10",
    "@next/bundle-analyzer": "16.3.4",
    "body-scroll-lock": "^4.0.0-beta.0",
    "contentlayer2": "0.5.8",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.2",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pliny": "patch:pliny@npm%3A0.4.1#~/.yarn/patches/pliny-npm-0.4.1-23b10fccc8.patch",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-citation": "^2.3.2",
    "rehype-katex": "^7.0.0",
    "rehype-preset-minify": "7.0.1",
    "rehype-prism-plus": "^2.0.2",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.0",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "2.1.0",
    "remark-math": "^6.0.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/mdx": "^2.0.14",
    "@types/node": "24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "concurrently": "10.0.5",
    "cross-env": "^10.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "17.5.0",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "eslint --fix"
    ],
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "prettier --write"
    ]
  },
  "resolutions": {
    "@giscus/react": "3.1.0",
    "contentlayer2": "0.5.8",
    "next-themes": "0.4.6",
    "kbar@npm:0.1.0-beta.45": "patch:kbar@npm%3A0.1.0-beta.45#~/.yarn/patches/kbar-npm-0.1.0-beta.45-790a9a69bc.patch",
    "react-virtual@npm:^2.8.2": "patch:react-virtual@npm%3A2.10.4#~/.yarn/patches/react-virtual-npm-2.10.4-bc003e5ddf.patch"
  },
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": ">=24.20.0",
    "yarn": ">=4.18.0"
  }
}
